<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 版本号 -->
            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v?"
                android:textSize="12sp"
                android:textColor="@color/outline"
                android:layout_marginBottom="8dp" />

            <!-- 标题 -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文件快移"
                android:textSize="24sp"
                android:textColor="@color/on_surface" />

            <!-- 源目录卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sourceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/source_label"
                            android:textSize="13sp"
                            android:textColor="@color/outline" />

                        <TextView
                            android:id="@+id/sourcePath"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/source_hint"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface"
                            android:ellipsize="middle"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sourceCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/sourceBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/select_source" />

            <!-- 箭头 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="↓"
                android:textSize="28sp"
                android:textColor="@color/primary"
                android:layout_gravity="center_horizontal" />

            <!-- 目标目录卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/destCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dest_label"
                            android:textSize="13sp"
                            android:textColor="@color/outline" />

                        <TextView
                            android:id="@+id/destPath"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dest_hint"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface"
                            android:ellipsize="middle"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/destCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/destBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/select_dest" />

            <!-- 移动按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/moveBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/start_move"
                android:textSize="18sp"
                app:cornerRadius="12dp" />

            <!-- 日志区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="日志："
                    android:textSize="13sp"
                    android:textColor="@color/outline" />

                <Button
                    android:id="@+id/copyLogBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="复制日志"
                    android:textSize="11sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/clearLogBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="清空"
                    android:textSize="11sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="4dp"
                android:background="#FFF8E1"
                android:padding="8dp">

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(等待操作...)"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
